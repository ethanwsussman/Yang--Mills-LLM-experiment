namespace YangMills.Construction.Tower
def SmoothingDerivAtOneOnAllSides : Prop :=
  ∀ L : ℕ, Conventions.IsAdmissibleBlockingFactor L → ∀ n k j : ℕ, 0 < n → j < k →
